# Written by princo deploy; changes here are overwritten.
[Unit]
Description=princo node fi (xray)
Wants=network-online.target
After=network-online.target

[Service]
Environment=XRAY_LOCATION_ASSET=/var/lib/princo/rules
ExecStart=/usr/local/lib/princo/xray-26.10.21/xray run -c /var/lib/princo/files/xray.json
DynamicUser=yes
StateDirectory=princo-xray
StateDirectoryMode=0700
SupplementaryGroups=princo-engine
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW
Restart=on-failure
RestartSec=10s
RestartPreventExitStatus=23
LimitNOFILE=infinity
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
LockPersonality=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK AF_UNIX
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
