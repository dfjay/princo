# Written by princo deploy; changes here are overwritten.
[Unit]
Description=princo node fi (xray 26.3.27)
Wants=network-online.target
After=network-online.target

[Service]
Environment=XRAY_LOCATION_ASSET=/var/lib/princo/rules
ExecStart=/usr/local/lib/princo/xray run -c /var/lib/princo/files/xray.json
DynamicUser=yes
StateDirectory=princo-xray
StateDirectoryMode=0700
# CAP_DAC_READ_SEARCH reads the rendered config and the certificates, both root's.
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_DAC_READ_SEARCH
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_DAC_READ_SEARCH
Restart=on-failure
RestartSec=10s
LimitNOFILE=infinity

[Install]
WantedBy=multi-user.target
