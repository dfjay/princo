# Written by princo deploy; changes here are overwritten.
# nginx connects to the engine from the clients' addresses; these rules
# keep the engine's replies on loopback. TCP is ipproto 6: a name would
# need /etc/protocols.
[Unit]
Description=princo node de: the engine's replies back to nginx
Before=nginx.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'while /usr/sbin/ip rule del pref 4430 iif lo ipproto 6 lookup 4430 2>/dev/null; do :; done; while /usr/sbin/ip -6 rule del pref 4430 iif lo ipproto 6 lookup 4430 2>/dev/null; do :; done; /usr/sbin/ip route del local 0.0.0.0/0 dev lo table 4430 2>/dev/null; /usr/sbin/ip -6 route del local ::/0 dev lo table 4430 2>/dev/null; true'
ExecStart=/usr/sbin/ip route replace local 0.0.0.0/0 dev lo table 4430
ExecStart=/usr/sbin/ip -6 route replace local ::/0 dev lo table 4430
ExecStart=/usr/sbin/ip rule add pref 4430 from 127.0.0.0/8 iif lo ipproto 6 sport 8444 lookup 4430
ExecStart=/usr/sbin/ip -6 rule add pref 4430 from ::1 iif lo ipproto 6 sport 8444 lookup 4430
ExecStart=/usr/sbin/ip rule add pref 4430 from 127.0.0.0/8 iif lo ipproto 6 sport 8445 lookup 4430
ExecStart=/usr/sbin/ip -6 rule add pref 4430 from ::1 iif lo ipproto 6 sport 8445 lookup 4430
ExecStop=/bin/sh -c 'while /usr/sbin/ip rule del pref 4430 iif lo ipproto 6 lookup 4430 2>/dev/null; do :; done; while /usr/sbin/ip -6 rule del pref 4430 iif lo ipproto 6 lookup 4430 2>/dev/null; do :; done; /usr/sbin/ip route del local 0.0.0.0/0 dev lo table 4430 2>/dev/null; /usr/sbin/ip -6 route del local ::/0 dev lo table 4430 2>/dev/null; true'

[Install]
# nginx, started or restarted, starts it again if it failed.
WantedBy=multi-user.target nginx.service
