# Written by princo deploy; changes here are overwritten.
[Unit]
Description=princo node relay (sing-box)
Wants=network-online.target
After=network-online.target

[Service]
ExecStart=/usr/local/lib/princo/sing-box-1.14.3/sing-box -D /var/lib/princo-sing-box -c /var/lib/princo/files/sing-box.json run
ExecReload=/bin/kill -HUP $MAINPID
DynamicUser=yes
StateDirectory=princo-sing-box
StateDirectoryMode=0700
SupplementaryGroups=princo-engine
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW
Restart=on-failure
RestartSec=10s
LimitNOFILE=infinity
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
LockPersonality=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK AF_UNIX
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
